/* ============================================
   ҚОСЫМША ҚОЛЖЕТІМДІЛІК ФУНКЦИЯЛАРЫ
============================================ */

function getSoundById(soundId) {
    return PROGRAM_DATA.sounds.find(
        sound => sound.id === soundId
    );
}

function getSoundByLetter(letter) {
    return PROGRAM_DATA.sounds.find(
        sound => sound.letter === letter
    );
}

function getStageById(stageId) {
    return PROGRAM_DATA.stageInfo.find(
        stage => stage.id === stageId
    );
}

function getAllSounds() {
    return PROGRAM_DATA.sounds;
}

function getArticulationExercises() {
    return PROGRAM_DATA.articulationExercises;
}

function getBreathingExercises() {
    return PROGRAM_DATA.breathingExercises;
}


